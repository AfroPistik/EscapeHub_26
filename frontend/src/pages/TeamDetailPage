import { useEffect, useState } from 'react'
import { Link, useParams } from 'react-router-dom'
import { teamsApi } from '../api/teamsApi'

const ERROR_MESSAGES_EL = {
  NOT_A_MEMBER: 'Δεν είσαι μέλος αυτής της ομάδας.',
  TEAM_NOT_FOUND: 'Η ομάδα δεν βρέθηκε.',
}

function getGreekErrorMessage(err) {
  if (err?.code && ERROR_MESSAGES_EL[err.code]) {
    return ERROR_MESSAGES_EL[err.code]
  }
  return 'Αδυναμία φόρτωσης ομάδας'
}

export function TeamDetailPage() {
  const { id } = useParams()
  const [team, setTeam] = useState(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState(null)

  useEffect(() => {
    if (!id) return
    let active = true
    setLoading(true)
    teamsApi
      .getTeamById(id)
      .then(data => {
        if (active) {
          setTeam(data)
          setError(null)
        }
      })
      .catch(err => {
        if (!active) return
        setError(getGreekErrorMessage(err))
      })
      .finally(() => {
        if (active) setLoading(false)
      })
    return () => {
      active = false
    }
  }, [id])

  if (loading) return <p>Φόρτωση στοιχείων ομάδας...</p>
  if (error) {
    return (
      <div>
        <p role="alert">{error}</p>
        <Link to="/teams">Επιστροφή στις ομάδες μου</Link>
      </div>
    )
  }
  if (!team) return null

  return (
    <main>
      <Link to="/teams">← Πίσω στις ομάδες μου</Link>
      <h1>{team.name}</h1>
      <p>
        Κωδικός πρόσκλησης: <strong>{team.inviteCode}</strong>
      </p>
    </main>
  )
}
